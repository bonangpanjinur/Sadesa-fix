{
  "name": "SaDesa",
  "short_name": "SaDesa",
  "id": "/",
  "lang": "id",
  "dir": "ltr",
  "description": "Marketplace UMKM & Desa Wisata Indonesia",
  "start_url": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "browser"
  ],
  "scope": "/",
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#10b981",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/file-handler",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      },
      "icons": [
        {
          "src": "/branding/sadesa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+sadesa",
      "url": "/protocol-handler?url=%s"
    }
  ],
  "categories": [
    "shopping",
    "business",
    "lifestyle"
  ],
  "shortcuts": [
    {
      "name": "Belanja Produk Desa",
      "short_name": "Belanja",
      "description": "Jelajahi produk UMKM desa",
      "url": "/shops",
      "icons": [
        {
          "src": "/branding/sadesa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pesanan Saya",
      "short_name": "Pesanan",
      "description": "Lihat status pesanan Anda",
      "url": "/orders",
      "icons": [
        {
          "src": "/branding/sadesa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Akun Saya",
      "short_name": "Akun",
      "description": "Buka profil dan pengaturan akun",
      "url": "/account",
      "icons": [
        {
          "src": "/branding/sadesa-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/sadesa-home-narrow.jpg",
      "sizes": "480x720",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Beranda SaDesa di perangkat mobile"
    },
    {
      "src": "/screenshots/sadesa-home-wide.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Beranda SaDesa di layar desktop"
    }
  ],
  "icons": [
    {
      "src": "/branding/sadesa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/branding/sadesa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "tab_strip": {
    "home_tab": {
      "scope": "/",
      "icons": [
        {
          "src": "branding/sadesa-icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  },
  "note_taking": {
    "new_note_url": "/?new_note=1"
  },
  "widgets": [
    {
      "name": "Ringkasan SaDesa",
      "short_name": "SaDesa",
      "description": "Ringkasan cepat aktivitas marketplace SaDesa",
      "tag": "sadesa-summary",
      "template": "sadesa-summary",
      "ms_ac_template": "widgets/sadesa-summary-template.json",
      "data": "widgets/sadesa-summary-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "widgets/sadesa-widget-preview.png",
          "sizes": "480x270",
          "label": "Widget ringkasan SaDesa"
        }
      ],
      "icons": [
        {
          "src": "branding/sadesa-icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 86400
    }
  ]
}
