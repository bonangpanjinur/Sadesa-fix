{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "SaDesa",
      "size": "Large",
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "${summary}",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Pesanan aktif",
          "value": "${activeOrders}"
        },
        {
          "title": "Notifikasi",
          "value": "${notifications}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Buka SaDesa",
      "url": "/"
    }
  ]
}
