# Public Supabase configuration injected at build time.
# These values are safe for browser use when Supabase RLS is correctly configured.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Google Maps JavaScript API key for the checkout pilot only.
# Enable Maps JavaScript API (and Places only if needed); restrict browser referrers to
# https://sadesa.id/* and https://www.sadesa.id/* for production.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
VITE_GOOGLE_MAPS_CHECKOUT_ENABLED=false
# Keep other map surfaces on their existing providers until separately approved.
VITE_GOOGLE_MAPS_RIDE_ENABLED=false

# Server key and opt-in flag are configured as Supabase Edge Function secrets,
# not here. Keep GOOGLE_MAPS_BILLING_ENABLED=false until daily API quotas and the
# approved Google Maps monthly budget are configured in Google Cloud.
# GOOGLE_MAPS_SERVER_API_KEY
# GOOGLE_MAPS_BILLING_ENABLED

# Railway provides PORT automatically for the static server/container.
# Never prefix server-only secrets with VITE_ and never put these in this file.
# Configure server-only values as Supabase Edge Function secrets instead:
# SUPABASE_SERVICE_ROLE_KEY, XENDIT_SECRET_KEY, XENDIT_CALLBACK_TOKEN,
# GDC_CLIENT_KEY, GDC_CLIENT_SECRET, GDC_PRIVATE_KEY_PEM, GDC_PARTNER_ID,
# GDC_CHANNEL_ID, GDC_DEVICE_ID. GDC_API_BASE_URL is optional and defaults to
# the GDC sandbox endpoint; use the production URL only after staging tests.
# Supabase-only Edge Function secrets (never Vercel/frontend):
# GDC_CLIENT_KEY, GDC_CLIENT_SECRET, GDC_PRIVATE_KEY_PEM, GDC_PARTNER_ID,
# GDC_CHANNEL_ID, GDC_DEVICE_ID, GDC_API_BASE_URL, ALLOWED_ORIGINS,
# GDC_ADMIN_PREVIEW_ENABLED. ALLOWED_ORIGINS is a comma-separated allowlist of
# approved browser origins. GDC_ADMIN_PREVIEW_ENABLED=true is sandbox-only.
# Vercel may contain only the public VITE_SUPABASE_* values and non-secret UI
# settings; never mirror GDC_*, ALLOWED_ORIGINS, or service-role credentials there.
# Also never put database passwords, private API keys, or signing secrets here.
