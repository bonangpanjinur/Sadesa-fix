# Public Supabase configuration injected at build time.
# These values are safe for browser use when Supabase RLS is correctly configured.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Public business profile shown on About, Contact, service and footer pages.
# Keep these values identical to the business documents and Xendit dashboard.
VITE_BUSINESS_BRAND_NAME=SaDesa
VITE_BUSINESS_LEGAL_NAME=PT RAKA SISTEM NUSANTARA
VITE_BUSINESS_ADDRESS=Isi alamat operasional lengkap di deployment production
VITE_BUSINESS_PHONE=08xxxxxxxxxx
VITE_BUSINESS_WHATSAPP=08xxxxxxxxxx
VITE_BUSINESS_EMAIL=support@sadesa.id
VITE_BUSINESS_OPERATING_HOURS=Setiap hari, 08.00-21.00 WIB
VITE_BUSINESS_SERVICE_AREA=Wilayah operasional SaDesa

# Google Maps JavaScript API key for the passenger ride map.
# Enable Maps JavaScript API and Places API, then restrict this key by domain.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Railway provides PORT automatically for the static server/container.
# Never prefix server-only secrets with VITE_ and never put these in this file:
# SUPABASE_SERVICE_ROLE_KEY, XENDIT_SECRET_KEY, XENDIT_CALLBACK_TOKEN,
# database passwords, private API keys, or signing secrets.
